{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/careops/conductor/tracks/rims_native_flow_quality_20261110/contracts/flow-admission.schema.json",
  "title": "CareOps RIMS source-only Power Automate flow admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_archive_sha256",
    "flows",
    "summary",
    "core_scope",
    "source_only",
    "native_verified"
  ],
  "properties": {
    "schema": {
      "const": "careops-rims.flow-admission/1"
    },
    "source_archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "core_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_only": {
      "const": true
    },
    "native_verified": {
      "const": false
    },
    "summary": {
      "type": "object",
      "required": [
        "flow_count",
        "nested_actions",
        "included_writes",
        "premium_candidate_flows",
        "unqualified_flows",
        "personal_path_candidate_flows",
        "invalid_flows"
      ],
      "additionalProperties": false,
      "properties": {
        "flow_count": {
          "type": "integer",
          "minimum": 1
        },
        "nested_actions": {
          "type": "integer",
          "minimum": 0
        },
        "included_writes": {
          "type": "integer",
          "minimum": 0
        },
        "premium_candidate_flows": {
          "type": "integer",
          "minimum": 0
        },
        "unqualified_flows": {
          "type": "integer",
          "minimum": 0
        },
        "personal_path_candidate_flows": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_flows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "nested_actions",
          "action_groups",
          "connectors",
          "premium_candidates",
          "unqualified_connectors",
          "source_included_writes",
          "personal_path_candidate",
          "errors",
          "source_only",
          "native_verified"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "nested_actions": {
            "type": "integer",
            "minimum": 0
          },
          "action_groups": {
            "type": "integer",
            "minimum": 0
          },
          "connectors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^shared_[a-zA-Z0-9_]+$"
            }
          },
          "premium_candidates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "unqualified_connectors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "source_included_writes": {
            "type": "integer",
            "minimum": 0
          },
          "personal_path_candidate": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "source_only": {
            "const": true
          },
          "native_verified": {
            "const": false
          }
        }
      }
    }
  }
}
