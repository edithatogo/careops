/// distinct source Payend
table 'Roster Payrun'

	column Payend
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Payend

	column 'Payrun End'
		dataType: string
		summarizeBy: none
		sourceColumn: Payrun End

	partition 'Roster Payrun' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Payend,Payrun End#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="roster--Payrun.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"Payend", type text}, {"Payrun End", type text}}, "en-AU")
				in
					Typed
