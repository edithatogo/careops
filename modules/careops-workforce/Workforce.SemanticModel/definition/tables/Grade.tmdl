/// Exact source grade retained; Queensland RMO means JHO plus SHO, never PHO/Registrar.
table Grade

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Grade Key'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: Grade Key

	/// Exact source grade retained; Queensland RMO means JHO plus SHO, never PHO/Registrar. Field: Grade
	column Grade
		dataType: string
		summarizeBy: none
		sourceColumn: Grade

	/// Exact source grade retained; Queensland RMO means JHO plus SHO, never PHO/Registrar. Field: Shared Tier
	column 'Shared Tier'
		dataType: string
		summarizeBy: none
		sourceColumn: Shared Tier

	/// Exact source grade retained; Queensland RMO means JHO plus SHO, never PHO/Registrar. Field: Conditional Ward Tier
	column 'Conditional Ward Tier'
		dataType: string
		summarizeBy: none
		sourceColumn: Conditional Ward Tier

	partition Grade = m
		mode: import
		source =
				let
					#"Loaded CSV" = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Grade Key,Grade,Shared Tier,Conditional Ward Tier#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="base--Grade.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(#"Loaded CSV", [PromoteAllScalars=true]),
					#"Preserved Nulls" = Table.ReplaceValue(#"Promoted Headers", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Promoted Headers")),
					#"Applied Types" = Table.TransformColumnTypes(#"Preserved Nulls", {{"Grade Key", Int64.Type}, {"Grade", type text}, {"Shared Tier", type text}, {"Conditional Ward Tier", type text}}, "en-AU")
				in
					#"Applied Types"
