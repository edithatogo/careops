/// one actual input admission; no fixture is actual evidence
table 'Evidence Status'

	column Dataset
		dataType: string
		summarizeBy: none
		sourceColumn: Dataset

	column Admission
		dataType: string
		summarizeBy: none
		sourceColumn: Admission

	column ActualEvaluation
		dataType: string
		summarizeBy: none
		sourceColumn: ActualEvaluation

	column CausalEffect
		dataType: string
		summarizeBy: none
		sourceColumn: CausalEffect

	partition 'Evidence Status' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Dataset,Admission,ActualEvaluation,CausalEffect#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="roster--Evidence Status.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"Dataset", type text}, {"Admission", type text}, {"ActualEvaluation", type text}, {"CausalEffect", type text}}, "en-AU")
				in
					Typed
