/// Candidate cover pools can coexist within a department/area. Counts are hypotheses, not actual roster counts. Candidate zero is unattributed/ambiguous.
table 'Roster Candidate'

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Candidate Key'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: Candidate Key

	/// Candidate cover pools can coexist within a department/area. Counts are hypotheses, not actual roster counts. Candidate zero is unattributed/ambiguous. Field: Candidate ID
	column 'Candidate ID'
		dataType: string
		summarizeBy: none
		sourceColumn: Candidate ID

	/// Candidate cover pools can coexist within a department/area. Counts are hypotheses, not actual roster counts. Candidate zero is unattributed/ambiguous. Field: Department
	column Department
		dataType: string
		summarizeBy: none
		sourceColumn: Department

	/// Candidate cover pools can coexist within a department/area. Counts are hypotheses, not actual roster counts. Candidate zero is unattributed/ambiguous. Field: Cost Centre
	column 'Cost Centre'
		dataType: string
		summarizeBy: none
		sourceColumn: Cost Centre

	/// Candidate cover pools can coexist within a department/area. Counts are hypotheses, not actual roster counts. Candidate zero is unattributed/ambiguous. Field: Clinical Family
	column 'Clinical Family'
		dataType: string
		summarizeBy: none
		sourceColumn: Clinical Family

	/// Candidate cover pools can coexist within a department/area. Counts are hypotheses, not actual roster counts. Candidate zero is unattributed/ambiguous. Field: Proposed Coverage Pool
	column 'Proposed Coverage Pool'
		dataType: string
		summarizeBy: none
		sourceColumn: Proposed Coverage Pool

	/// Candidate cover pools can coexist within a department/area. Counts are hypotheses, not actual roster counts. Candidate zero is unattributed/ambiguous. Field: Identity Status
	column 'Identity Status'
		dataType: string
		summarizeBy: none
		sourceColumn: Identity Status

	partition 'Roster Candidate' = m
		mode: import
		source =
				let
					#"Loaded CSV" = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Candidate Key,Candidate ID,Department,Cost Centre,Clinical Family,Proposed Coverage Pool,Identity Status#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="base--Roster Candidate.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(#"Loaded CSV", [PromoteAllScalars=true]),
					#"Preserved Nulls" = Table.ReplaceValue(#"Promoted Headers", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Promoted Headers")),
					#"Applied Types" = Table.TransformColumnTypes(#"Preserved Nulls", {{"Candidate Key", Int64.Type}, {"Candidate ID", type text}, {"Department", type text}, {"Cost Centre", type text}, {"Clinical Family", type text}, {"Proposed Coverage Pool", type text}, {"Identity Status", type text}}, "en-AU")
				in
					#"Applied Types"
