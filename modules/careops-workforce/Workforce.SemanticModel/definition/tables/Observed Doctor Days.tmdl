/// Observed work per doctor/day/area/grade/candidate, including zero overtime. Missing workforce records are not zero-hours doctors.
table 'Observed Doctor Days'

	/// Distinct doctor/date pairs in selected observed work; not sum of roster memberships or funded FTE.
	measure 'Observed Doctor Work Days' = COUNTROWS(SUMMARIZE('Observed Doctor Days', 'Observed Doctor Days'[Doctor Key], 'Observed Doctor Days'[Date Key]))
		formatString: #,##0
		displayFolder: Observed burden

	/// Distinct observed doctor/dates with source overtime-rate or RCAL intervals. Zero only within an observed work scope; missing remains BLANK.
	measure 'Observed Doctor Overtime Days' = IF([Observed Doctor Work Days] > 0, COALESCE(CALCULATE([Observed Doctor Work Days], KEEPFILTERS('Observed Doctor Days'[Overtime Observed] = TRUE())), 0))
		formatString: #,##0
		displayFolder: Observed burden

	/// Observed doctor/day frequency; missing coverage is not a zero.
	measure 'Overtime Day Frequency' = DIVIDE([Observed Doctor Overtime Days], [Observed Doctor Work Days])
		formatString: 0.0%
		displayFolder: Observed burden

	/// Median across distinct observed doctor/day totals under selected areas/grades/candidates. Cross-area simultaneous charging can overlap; use an area selection for duty interpretation.
	measure 'Median Recorded Hours Per Observed Doctor Day' = MEDIANX(SUMMARIZE('Observed Doctor Days', 'Observed Doctor Days'[Doctor Key], 'Observed Doctor Days'[Date Key]), DIVIDE(CALCULATE(SUM('Observed Doctor Days'[Regular Milliseconds]) + SUM('Observed Doctor Days'[Overtime Rate Milliseconds]) + SUM('Observed Doctor Days'[RCAL Milliseconds])), 3600000))
		formatString: #,##0.00
		displayFolder: Observed burden

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Area Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Area Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Doctor Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Doctor Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Grade Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Grade Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Date Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Payrun Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Payrun Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Candidate Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Candidate Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Regular Milliseconds'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Regular Milliseconds

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Overtime Rate Milliseconds'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Overtime Rate Milliseconds

	/// Hidden technical key, audit value or explicit-measure input.
	column 'RCAL Milliseconds'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: RCAL Milliseconds

	/// Observed work per doctor/day/area/grade/candidate, including zero overtime. Missing workforce records are not zero-hours doctors. Field: Overtime Observed
	column 'Overtime Observed'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Overtime Observed

	partition 'Observed Doctor Days' = m
		mode: import
		source =
				let
					#"Loaded CSV" = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Area Key,Doctor Key,Grade Key,Date Key,Payrun Key,Candidate Key,Regular Milliseconds,Overtime Rate Milliseconds,RCAL Milliseconds,Overtime Observed#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="base--Observed Doctor Days.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(#"Loaded CSV", [PromoteAllScalars=true]),
					#"Preserved Nulls" = Table.ReplaceValue(#"Promoted Headers", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Promoted Headers")),
					#"Applied Types" = Table.TransformColumnTypes(#"Preserved Nulls", {{"Area Key", Int64.Type}, {"Doctor Key", Int64.Type}, {"Grade Key", Int64.Type}, {"Date Key", Int64.Type}, {"Payrun Key", Int64.Type}, {"Candidate Key", Int64.Type}, {"Regular Milliseconds", Int64.Type}, {"Overtime Rate Milliseconds", Int64.Type}, {"RCAL Milliseconds", Int64.Type}, {"Overtime Observed", type logical}}, "en-AU")
				in
					#"Applied Types"
