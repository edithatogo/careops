/// Supplied fiscal calendar; older dates only have observed payrun endpoints, without invented fiscal labels.
table Payrun

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Payrun Key'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: Payrun Key

	/// Supplied fiscal calendar; older dates only have observed payrun endpoints, without invented fiscal labels. Field: Pay End
	column 'Pay End'
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: Pay End

	/// Supplied fiscal calendar; older dates only have observed payrun endpoints, without invented fiscal labels. Field: Fiscal Year
	column 'Fiscal Year'
		dataType: int64
		summarizeBy: none
		sourceColumn: Fiscal Year

	/// Supplied fiscal calendar; older dates only have observed payrun endpoints, without invented fiscal labels. Field: Fortnight
	column Fortnight
		dataType: int64
		summarizeBy: none
		sourceColumn: Fortnight

	/// Supplied fiscal calendar; older dates only have observed payrun endpoints, without invented fiscal labels. Field: Start Date
	column 'Start Date'
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: Start Date

	/// Supplied fiscal calendar; older dates only have observed payrun endpoints, without invented fiscal labels. Field: Calendar Basis
	column 'Calendar Basis'
		dataType: string
		summarizeBy: none
		sourceColumn: Calendar Basis

	partition Payrun = m
		mode: import
		source =
				let
					#"Loaded CSV" = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Payrun Key,Pay End,Fiscal Year,Fortnight,Start Date,Calendar Basis#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="base--Payrun.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(#"Loaded CSV", [PromoteAllScalars=true]),
					#"Preserved Nulls" = Table.ReplaceValue(#"Promoted Headers", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Promoted Headers")),
					#"Applied Types" = Table.TransformColumnTypes(#"Preserved Nulls", {{"Payrun Key", Int64.Type}, {"Pay End", type date}, {"Fiscal Year", Int64.Type}, {"Fortnight", Int64.Type}, {"Start Date", type date}, {"Calendar Basis", type text}}, "en-AU")
				in
					#"Applied Types"
