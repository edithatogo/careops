/// Aggregate source-evidence observations; separate scope, not current staffing or approved events.
table 'Historical Skill Evidence'

	measure 'Verified Skill Cover' = BLANK()
		formatString: #,##0.00

	measure 'Required Skill Cover' = BLANK()
		formatString: #,##0.00

	measure 'Skill Staffing Difference' = BLANK()
		formatString: #,##0.00

	column Evidence
		dataType: string
		summarizeBy: none
		sourceColumn: Evidence

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status

	partition 'Historical Skill Evidence' = m
		mode: import
		source =
				let
				Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Evidence,Status#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="embedded--Historical Skill Evidence.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"Evidence", type text},{"Status", type text}})
				in Typed
