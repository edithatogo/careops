table 'Planning__Rotation Paths'

	column person
		dataType: string
		summarizeBy: none
		sourceColumn: person

	column version
		dataType: string
		summarizeBy: none
		sourceColumn: version

	column grain
		dataType: string
		summarizeBy: none
		sourceColumn: grain

	column origin
		dataType: string
		summarizeBy: none
		sourceColumn: origin

	column destination
		dataType: string
		summarizeBy: none
		sourceColumn: destination

	column gap
		dataType: double
		summarizeBy: none
		sourceColumn: gap

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column source_revision
		dataType: string
		summarizeBy: none
		sourceColumn: source_revision

	column source_as_of
		dataType: string
		summarizeBy: none
		sourceColumn: source_as_of

	column uncertainty
		dataType: string
		summarizeBy: none
		sourceColumn: uncertainty

	partition 'Planning__Rotation Paths' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("person,version,grain,origin,destination,gap,status,source_revision,source_as_of,uncertainty#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="planning--Rotation Paths.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"person", type text}, {"version", type text}, {"grain", type text}, {"origin", type text}, {"destination", type text}, {"gap", type number}, {"status", type text}, {"source_revision", type text}, {"source_as_of", type text}, {"uncertainty", type text}}, "en-AU")
				in
					Typed
