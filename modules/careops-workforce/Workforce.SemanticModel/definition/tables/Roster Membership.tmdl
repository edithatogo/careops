/// One observed doctor/normalised assignment/payrun/candidate/grade/evidence combination. Nonadditive observation bridge, never a staffing denominator or paid-cost allocation.
table 'Roster Membership'

	/// Eligible work-record evidence for dated doctor/assignment/payrun/candidate links. Not headcount or a roster count.
	measure 'Observed Membership Records' = SUM('Roster Membership'[Eligible Source Records])
		formatString: #,##0
		displayFolder: Roster evidence

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Area Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Area Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Doctor Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Doctor Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Payrun Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Payrun Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Candidate Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Candidate Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Grade Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Grade Key

	/// One observed doctor/normalised assignment/payrun/candidate/grade/evidence combination. Nonadditive observation bridge, never a staffing denominator or paid-cost allocation. Field: Link Evidence
	column 'Link Evidence'
		dataType: string
		summarizeBy: none
		sourceColumn: Link Evidence

	/// One observed doctor/normalised assignment/payrun/candidate/grade/evidence combination. Nonadditive observation bridge, never a staffing denominator or paid-cost allocation. Field: Service Evidence
	column 'Service Evidence'
		dataType: string
		summarizeBy: none
		sourceColumn: Service Evidence

	/// One observed doctor/normalised assignment/payrun/candidate/grade/evidence combination. Nonadditive observation bridge, never a staffing denominator or paid-cost allocation. Field: Assignment Alias
	column 'Assignment Alias'
		dataType: string
		summarizeBy: none
		sourceColumn: Assignment Alias

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Eligible Source Records'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Eligible Source Records

	partition 'Roster Membership' = m
		mode: import
		source =
				let
					#"Loaded CSV" = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Area Key,Doctor Key,Payrun Key,Candidate Key,Grade Key,Link Evidence,Service Evidence,Assignment Alias,Eligible Source Records#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="base--Roster Membership.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(#"Loaded CSV", [PromoteAllScalars=true]),
					#"Preserved Nulls" = Table.ReplaceValue(#"Promoted Headers", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Promoted Headers")),
					#"Applied Types" = Table.TransformColumnTypes(#"Preserved Nulls", {{"Area Key", Int64.Type}, {"Doctor Key", Int64.Type}, {"Payrun Key", Int64.Type}, {"Candidate Key", Int64.Type}, {"Grade Key", Int64.Type}, {"Link Evidence", type text}, {"Service Evidence", type text}, {"Assignment Alias", type text}, {"Eligible Source Records", Int64.Type}}, "en-AU")
				in
					#"Applied Types"
