table 'Planning__Paid Ledger'

	column Person
		dataType: string
		summarizeBy: none
		sourceColumn: Person

	column Service
		dataType: string
		summarizeBy: none
		sourceColumn: Service

	column Grade
		dataType: string
		summarizeBy: none
		sourceColumn: Grade

	column PayrunEnd
		dataType: string
		summarizeBy: none
		sourceColumn: PayrunEnd

	column Kind
		dataType: string
		summarizeBy: none
		sourceColumn: Kind

	column PaidHours
		dataType: string
		summarizeBy: none
		sourceColumn: PaidHours

	column PaidCost
		dataType: double
		summarizeBy: none
		sourceColumn: PaidCost

	column DutyAllocation
		dataType: string
		summarizeBy: none
		sourceColumn: DutyAllocation

	column SourceRevision
		dataType: string
		summarizeBy: none
		sourceColumn: SourceRevision

	partition 'Planning__Paid Ledger' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Person,Service,Grade,PayrunEnd,Kind,PaidHours,PaidCost,DutyAllocation,SourceRevision#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="planning--Paid Ledger.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"Person", type text}, {"Service", type text}, {"Grade", type text}, {"PayrunEnd", type text}, {"Kind", type text}, {"PaidHours", type text}, {"PaidCost", type number}, {"DutyAllocation", type text}, {"SourceRevision", type text}}, "en-AU")
				in
					Typed
