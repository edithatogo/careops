table 'Planning__Rule Checks'

	column rule_id
		dataType: string
		summarizeBy: none
		sourceColumn: rule_id

	column clause
		dataType: string
		summarizeBy: none
		sourceColumn: clause

	column strength
		dataType: string
		summarizeBy: none
		sourceColumn: strength

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column missing
		dataType: string
		summarizeBy: none
		sourceColumn: missing

	column period
		dataType: string
		summarizeBy: none
		sourceColumn: period

	column legal_breach
		dataType: string
		summarizeBy: none
		sourceColumn: legal_breach

	column source_revision
		dataType: string
		summarizeBy: none
		sourceColumn: source_revision

	column source_as_of
		dataType: string
		summarizeBy: none
		sourceColumn: source_as_of

	column uncertainty
		dataType: string
		summarizeBy: none
		sourceColumn: uncertainty

	partition 'Planning__Rule Checks' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("rule_id,clause,strength,status,missing,period,legal_breach,source_revision,source_as_of,uncertainty#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="planning--Rule Checks.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"rule_id", type text}, {"clause", type text}, {"strength", type text}, {"status", type text}, {"missing", type text}, {"period", type text}, {"legal_breach", type text}, {"source_revision", type text}, {"source_as_of", type text}, {"uncertainty", type text}}, "en-AU")
				in
					Typed
