/// Pseudonymous within-build doctor key; no employee names or payroll identifiers. Still sensitive person-level data.
table Doctor

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Doctor Key'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: Doctor Key

	/// Pseudonymous within-build doctor key; no employee names or payroll identifiers. Still sensitive person-level data. Field: Doctor Alias
	column 'Doctor Alias'
		dataType: string
		summarizeBy: none
		sourceColumn: Doctor Alias

	partition Doctor = m
		mode: import
		source =
				let
					#"Loaded CSV" = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Doctor Key,Doctor Alias#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="base--Doctor.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(#"Loaded CSV", [PromoteAllScalars=true]),
					#"Preserved Nulls" = Table.ReplaceValue(#"Promoted Headers", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Promoted Headers")),
					#"Applied Types" = Table.TransformColumnTypes(#"Preserved Nulls", {{"Doctor Key", Int64.Type}, {"Doctor Alias", type text}}, "en-AU")
				in
					#"Applied Types"
