table Planning__Exceptions

	column kind
		dataType: string
		summarizeBy: none
		sourceColumn: kind

	column source_row
		dataType: double
		summarizeBy: none
		sourceColumn: source_row

	column evidence
		dataType: string
		summarizeBy: none
		sourceColumn: evidence

	column priority_components
		dataType: string
		summarizeBy: none
		sourceColumn: priority_components

	column adjudication
		dataType: string
		summarizeBy: none
		sourceColumn: adjudication

	column source_revision
		dataType: string
		summarizeBy: none
		sourceColumn: source_revision

	column source_as_of
		dataType: string
		summarizeBy: none
		sourceColumn: source_as_of

	column uncertainty
		dataType: string
		summarizeBy: none
		sourceColumn: uncertainty

	partition Planning__Exceptions = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("kind,source_row,evidence,priority_components,adjudication,source_revision,source_as_of,uncertainty#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="planning--Exceptions.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"kind", type text}, {"source_row", type number}, {"evidence", type text}, {"priority_components", type text}, {"adjudication", type text}, {"source_revision", type text}, {"source_as_of", type text}, {"uncertainty", type text}}, "en-AU")
				in
					Typed
