		summarizeBy: none
		sourceColumn: origin

	column version
		dataType: string
		summarizeBy: none
		sourceColumn: version

	column window
		dataType: string
		summarizeBy: none
		sourceColumn: window

	column period_start
		dataType: string
		summarizeBy: none
		sourceColumn: period_start

	column period_end
		dataType: string
		summarizeBy: none
		sourceColumn: period_end

	column hours
		dataType: double
		summarizeBy: none
		sourceColumn: hours

	column state
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column coverage_complete
		dataType: boolean
		summarizeBy: none
		sourceColumn: coverage_complete

	column source_revision
		dataType: string
		summarizeBy: none
		sourceColumn: source_revision

	column source_as_of
