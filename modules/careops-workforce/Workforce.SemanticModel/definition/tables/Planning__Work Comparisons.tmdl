table 'Planning__Work Comparisons'

	column prior_period
		dataType: string
		summarizeBy: none
		sourceColumn: prior_period

	column period
		dataType: string
		summarizeBy: none
		sourceColumn: period

	column metric
		dataType: string
		summarizeBy: none
		sourceColumn: metric

	column total_change
		dataType: double
		summarizeBy: none
		sourceColumn: total_change

	column within_person_change
		dataType: double
		summarizeBy: none
		sourceColumn: within_person_change

	column entrants
		dataType: double
		summarizeBy: none
		sourceColumn: entrants

	column exits
		dataType: double
		summarizeBy: none
		sourceColumn: exits

	column common_people
		dataType: double
		summarizeBy: none
		sourceColumn: common_people

	column causal_effect
		dataType: double
		summarizeBy: none
		sourceColumn: causal_effect

	column source_revision
		dataType: string
		summarizeBy: none
		sourceColumn: source_revision

	column source_as_of
		dataType: string
		summarizeBy: none
		sourceColumn: source_as_of

	column uncertainty
		dataType: string
		summarizeBy: none
		sourceColumn: uncertainty

	partition 'Planning__Work Comparisons' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("prior_period,period,metric,total_change,within_person_change,entrants,exits,common_people,causal_effect,source_revision,source_as_of,uncertainty#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="planning--Work Comparisons.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"prior_period", type text}, {"period", type text}, {"metric", type text}, {"total_change", type number}, {"within_person_change", type number}, {"entrants", type number}, {"exits", type number}, {"common_people", type number}, {"causal_effect", type number}, {"source_revision", type text}, {"source_as_of", type text}, {"uncertainty", type text}}, "en-AU")
				in
					Typed
