/// Aggregate source-evidence observations; separate scope, not current staffing or approved events.
table 'Movement Context'

	measure 'Source Context Records' = SUM('Movement Context'[Context Records])
		formatString: #,##0

	column 'Context Type'
		dataType: string
		summarizeBy: none
		sourceColumn: Context Type

	column 'Evidence Status'
		dataType: string
		summarizeBy: none
		sourceColumn: Evidence Status

	column 'Context Records'
		dataType: int64
		summarizeBy: none
		sourceColumn: Context Records

	partition 'Movement Context' = m
		mode: import
		source =
				let
				Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Context Type,Evidence Status,Context Records#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="embedded--Movement Context.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"Context Type", type text},{"Evidence Status", type text},{"Context Records", Int64.Type}})
				in Typed
