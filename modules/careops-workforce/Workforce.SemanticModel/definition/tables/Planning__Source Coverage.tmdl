table 'Planning__Source Coverage'

	column Family
		dataType: string
		summarizeBy: none
		sourceColumn: Family

	column Records
		dataType: double
		summarizeBy: none
		sourceColumn: Records

	column PopulationComplete
		dataType: boolean
		summarizeBy: none
		sourceColumn: PopulationComplete

	column SourceAsOf
		dataType: string
		summarizeBy: none
		sourceColumn: SourceAsOf

	column SourceRevision
		dataType: string
		summarizeBy: none
		sourceColumn: SourceRevision

	partition 'Planning__Source Coverage' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Family,Records,PopulationComplete,SourceAsOf,SourceRevision#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="planning--Source Coverage.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"Family", type text}, {"Records", type number}, {"PopulationComplete", type logical}, {"SourceAsOf", type text}, {"SourceRevision", type text}}, "en-AU")
				in
					Typed
