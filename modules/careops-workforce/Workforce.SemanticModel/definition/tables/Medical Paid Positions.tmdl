/// One medical-cohort position payment row. Gross amount has no OT separation. These are neither funded establishment nor complete current staffing denominators; no area allocation.
table 'Medical Paid Positions'

	/// Medical paid-position observations only; no department assignment, complete current workforce, funded FTE or OT-cost allocation. Area/roster filters return BLANK.
	measure 'Medical Gross Payroll' = IF(NOT ISCROSSFILTERED('Area') && NOT ISCROSSFILTERED('Roster Candidate'), SUM('Medical Paid Positions'[Gross Amount]))
		formatString: $#,##0.00
		displayFolder: Paid-position observations

	/// Medical paid-position observations only; no department assignment, complete current workforce, funded FTE or OT-cost allocation. Area/roster filters return BLANK.
	measure 'Medical HR Payment Hours' = IF(NOT ISCROSSFILTERED('Area') && NOT ISCROSSFILTERED('Roster Candidate'), SUM('Medical Paid Positions'[HR Payment Hours]))
		formatString: #,##0.00
		displayFolder: Paid-position observations

	/// Medical paid-position observations only; no department assignment, complete current workforce, funded FTE or OT-cost allocation. Area/roster filters return BLANK.
	measure 'Medical FTE Payment Hours' = IF(NOT ISCROSSFILTERED('Area') && NOT ISCROSSFILTERED('Roster Candidate'), SUM('Medical Paid Positions'[FTE Payment Hours]))
		formatString: #,##0.00
		displayFolder: Paid-position observations

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Doctor Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Doctor Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Date Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Payrun Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Payrun Key

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Grade Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Grade Key

	/// One medical-cohort position payment row. Gross amount has no OT separation. These are neither funded establishment nor complete current staffing denominators; no area allocation. Field: Medical Position Title
	column 'Medical Position Title'
		dataType: string
		summarizeBy: none
		sourceColumn: Medical Position Title

	/// One medical-cohort position payment row. Gross amount has no OT separation. These are neither funded establishment nor complete current staffing denominators; no area allocation. Field: Employment Group
	column 'Employment Group'
		dataType: string
		summarizeBy: none
		sourceColumn: Employment Group

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Gross Amount'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: Gross Amount

	/// Hidden technical key, audit value or explicit-measure input.
	column 'FTE Payment Hours'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: FTE Payment Hours

	/// Hidden technical key, audit value or explicit-measure input.
	column 'HR Payment Hours'
		dataType: decimal
		isHidden
		summarizeBy: none
		sourceColumn: HR Payment Hours

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Source Row'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Source Row

	partition 'Medical Paid Positions' = m
		mode: import
		source =
				let
					#"Loaded CSV" = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Doctor Key,Date Key,Payrun Key,Grade Key,Medical Position Title,Employment Group,Gross Amount,FTE Payment Hours,HR Payment Hours,Source Row#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="base--Medical Paid Positions.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(#"Loaded CSV", [PromoteAllScalars=true]),
					#"Preserved Nulls" = Table.ReplaceValue(#"Promoted Headers", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Promoted Headers")),
					#"Applied Types" = Table.TransformColumnTypes(#"Preserved Nulls", {{"Doctor Key", Int64.Type}, {"Date Key", Int64.Type}, {"Payrun Key", Int64.Type}, {"Grade Key", Int64.Type}, {"Medical Position Title", type text}, {"Employment Group", type text}, {"Gross Amount", Currency.Type}, {"FTE Payment Hours", Currency.Type}, {"HR Payment Hours", Currency.Type}, {"Source Row", Int64.Type}}, "en-AU")
				in
					#"Applied Types"
