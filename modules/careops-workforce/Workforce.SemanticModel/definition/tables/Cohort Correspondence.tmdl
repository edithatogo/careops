/// Planned roster and worked timesheet temporal unions by source version and payrun. Disconnected to prevent summing alternative versions; selected matching key is applied explicitly.
table 'Cohort Correspondence'

	/// Temporal union hours for exactly one source cohort; missing worked evidence withholds comparisons.
	measure 'Planned Hours' = IF(HASONEVALUE('Cohort Matching'[CohortKey]), CALCULATE(DIVIDE(SELECTEDVALUE('Cohort Correspondence'[planned_minutes]), 60), TREATAS(VALUES('Cohort Matching'[CohortKey]), 'Cohort Correspondence'[CohortKey])), BLANK())
		formatString: #,##0.00

	/// Temporal union hours for exactly one source cohort; missing worked evidence withholds comparisons.
	measure 'Worked Hours' = IF(HASONEVALUE('Cohort Matching'[CohortKey]), CALCULATE(DIVIDE(SELECTEDVALUE('Cohort Correspondence'[worked_minutes]), 60), TREATAS(VALUES('Cohort Matching'[CohortKey]), 'Cohort Correspondence'[CohortKey])), BLANK())
		formatString: #,##0.00

	/// Temporal union hours for exactly one source cohort; missing worked evidence withholds comparisons.
	measure 'Shared Hours' = IF(HASONEVALUE('Cohort Matching'[CohortKey]), CALCULATE(DIVIDE(SELECTEDVALUE('Cohort Correspondence'[shared_minutes]), 60), TREATAS(VALUES('Cohort Matching'[CohortKey]), 'Cohort Correspondence'[CohortKey])), BLANK())
		formatString: #,##0.00

	/// Temporal union hours for exactly one source cohort; missing worked evidence withholds comparisons.
	measure 'Planned Only Hours' = IF(HASONEVALUE('Cohort Matching'[CohortKey]), CALCULATE(DIVIDE(SELECTEDVALUE('Cohort Correspondence'[planned_only_minutes]), 60), TREATAS(VALUES('Cohort Matching'[CohortKey]), 'Cohort Correspondence'[CohortKey])), BLANK())
		formatString: #,##0.00

	/// Temporal union hours for exactly one source cohort; missing worked evidence withholds comparisons.
	measure 'Worked Only Hours' = IF(HASONEVALUE('Cohort Matching'[CohortKey]), CALCULATE(DIVIDE(SELECTEDVALUE('Cohort Correspondence'[worked_only_minutes]), 60), TREATAS(VALUES('Cohort Matching'[CohortKey]), 'Cohort Correspondence'[CohortKey])), BLANK())
		formatString: #,##0.00

	column CohortKey
		dataType: string
		summarizeBy: none
		sourceColumn: CohortKey

	column Scope
		dataType: string
		summarizeBy: none
		sourceColumn: Scope

	column 'Worked Source'
		dataType: string
		summarizeBy: none
		sourceColumn: Worked Source

	column planned_minutes
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: planned_minutes

	column worked_minutes
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: worked_minutes

	column shared_minutes
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: shared_minutes

	column planned_only_minutes
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: planned_only_minutes

	column worked_only_minutes
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: worked_only_minutes

	partition 'Cohort Correspondence' = m
		mode: import
		source =
				let
				Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("CohortKey,Scope,Worked Source,planned_minutes,worked_minutes,shared_minutes,planned_only_minutes,worked_only_minutes#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="embedded--Cohort Correspondence.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				Nullable = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"planned_minutes","worked_minutes","shared_minutes","planned_only_minutes","worked_only_minutes"}),
				Typed = Table.TransformColumnTypes(Nullable, {{"CohortKey", type text},{"Scope", type text},{"Worked Source", type text},{"planned_minutes", Int64.Type},{"worked_minutes", Int64.Type},{"shared_minutes", Int64.Type},{"planned_only_minutes", Int64.Type},{"worked_only_minutes", Int64.Type}})
				in Typed
