/// one explicit input per scenario sensitivity case; not observed facts
table 'Scenario Assumptions'

	column Case
		dataType: string
		summarizeBy: none
		sourceColumn: Case

	column Scenario
		dataType: string
		summarizeBy: none
		sourceColumn: Scenario

	column Parameter
		dataType: string
		summarizeBy: none
		sourceColumn: Parameter

	column Value
		dataType: string
		summarizeBy: none
		sourceColumn: Value

	partition 'Scenario Assumptions' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Case,Scenario,Parameter,Value#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="roster--Scenario Assumptions.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"Case", type text}, {"Scenario", type text}, {"Parameter", type text}, {"Value", type text}}, "en-AU")
				in
					Typed
