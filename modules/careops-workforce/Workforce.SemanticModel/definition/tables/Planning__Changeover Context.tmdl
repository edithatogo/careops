					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"person", type text}, {"version", type text}, {"period", type text}, {"origin", type text}, {"destination", type text}, {"prior_observed_hours", type number}, {"post_observed_hours", type number}, {"recorded_difference", type number}, {"prior_source_days", type number}, {"post_source_days", type number}, {"comparable_complete_difference", type text}, {"causal_effect", type number}, {"source_revision", type text}, {"source_as_of", type text}, {"uncertainty", type text}}, "en-AU")
