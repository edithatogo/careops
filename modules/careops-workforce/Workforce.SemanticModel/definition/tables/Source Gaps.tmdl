/// qualified P3 exception category/scope; not staffing shortfall
table 'Source Gaps'

	column Version
		dataType: string
		summarizeBy: none
		sourceColumn: Version

	column Issue
		dataType: string
		summarizeBy: none
		sourceColumn: Issue

	column 'Affected Cohorts'
		dataType: string
		summarizeBy: none
		sourceColumn: Affected Cohorts

	column 'Staffing Shortfall'
		dataType: string
		summarizeBy: none
		sourceColumn: Staffing Shortfall

	column 'Causal Driver'
		dataType: string
		summarizeBy: none
		sourceColumn: Causal Driver

	partition 'Source Gaps' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Version,Issue,Affected Cohorts,Staffing Shortfall,Causal Driver#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="roster--Source Gaps.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"Version", type text}, {"Issue", type text}, {"Affected Cohorts", type text}, {"Staffing Shortfall", type text}, {"Causal Driver", type text}}, "en-AU")
				in
					Typed
