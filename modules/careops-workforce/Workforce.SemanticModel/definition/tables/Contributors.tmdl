/// charged area/grade/payrun/code/category
table Contributors

	/// Qualified aggregate; single_category; source unknowns retained.
	measure 'Signed Contributor Hours' = IF(HASONEVALUE('Contributors'[Category]), IF(COUNT('Contributors'[Signed Nanohours]) = COUNTROWS('Contributors'), DIVIDE(SUM('Contributors'[Signed Nanohours]), 1000000000)))
		formatString: #,##0.00

	column 'Charged Area'
		dataType: string
		summarizeBy: none
		sourceColumn: Charged Area

	column Grade
		dataType: string
		summarizeBy: none
		sourceColumn: Grade

	column Payend
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Payend

	column Code
		dataType: string
		summarizeBy: none
		sourceColumn: Code

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column 'Signed Nanohours'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Signed Nanohours

	column 'Payrun End'
		dataType: string
		summarizeBy: none
		sourceColumn: Payrun End

	partition Contributors = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Charged Area,Grade,Payend,Code,Category,Signed Nanohours,Payrun End#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="roster--Contributors.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"Charged Area", type text}, {"Grade", type text}, {"Payend", type text}, {"Code", type text}, {"Category", type text}, {"Signed Nanohours", Int64.Type}, {"Payrun End", type text}}, "en-AU")
				in
					Typed
