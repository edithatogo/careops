/// Clock-hour bins, source timestamps in the recorded local-time convention; timezone not independently verified.
table 'Clock Hour'

	/// Clock-hour bins, source timestamps in the recorded local-time convention; timezone not independently verified. Field: Clock Hour
	column 'Clock Hour'
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: Clock Hour

	/// Clock-hour bins, source timestamps in the recorded local-time convention; timezone not independently verified. Field: Period Of Day
	column 'Period Of Day'
		dataType: string
		summarizeBy: none
		sourceColumn: Period Of Day

	partition 'Clock Hour' = m
		mode: import
		source =
				let
					#"Loaded CSV" = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Clock Hour,Period Of Day#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="base--Clock Hour.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(#"Loaded CSV", [PromoteAllScalars=true]),
					#"Preserved Nulls" = Table.ReplaceValue(#"Promoted Headers", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Promoted Headers")),
					#"Applied Types" = Table.TransformColumnTypes(#"Preserved Nulls", {{"Clock Hour", Int64.Type}, {"Period Of Day", type text}}, "en-AU")
				in
					#"Applied Types"
