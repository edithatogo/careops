					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"origin", type text}, {"period_start", type text}, {"period_end", type text}, {"service", type text}, {"grade", type text}, {"population", type number}, {"above", type number}, {"unknown", type number}, {"evaluated", type number}, {"max_observed_hours", type number}, {"excess_hours", type number}, {"target_met", type logical}, {"source_revision", type text}, {"source_as_of", type text}, {"uncertainty", type text}}, "en-AU")
