/// one observed paid group/payrun pair; signed descriptive decomposition
table 'Paid Contributor Bridge'

	/// Qualified aggregate; single_scope; source unknowns retained.
	measure 'Paid Cost Change AUD' = IF(COUNTROWS('Paid Contributor Bridge') = 1, IF(COUNT('Paid Contributor Bridge'[Cost Change Nanoaud]) = COUNTROWS('Paid Contributor Bridge'), DIVIDE(SUM('Paid Contributor Bridge'[Cost Change Nanoaud]), 1000000000)))
		formatString: #,##0.00

	/// Qualified aggregate; single_scope; source unknowns retained.
	measure 'Paid Volume Effect AUD' = IF(COUNTROWS('Paid Contributor Bridge') = 1, IF(COUNT('Paid Contributor Bridge'[Volume Nanoaud]) = COUNTROWS('Paid Contributor Bridge'), DIVIDE(SUM('Paid Contributor Bridge'[Volume Nanoaud]), 1000000000)))
		formatString: #,##0.00

	/// Qualified aggregate; single_scope; source unknowns retained.
	measure 'Paid Effective Rate Mix AUD' = IF(COUNTROWS('Paid Contributor Bridge') = 1, IF(COUNT('Paid Contributor Bridge'[Rate Mix Nanoaud]) = COUNTROWS('Paid Contributor Bridge'), DIVIDE(SUM('Paid Contributor Bridge'[Rate Mix Nanoaud]), 1000000000)))
		formatString: #,##0.00

	/// Qualified aggregate; single_scope; source unknowns retained.
	measure 'Paid Residual AUD' = IF(COUNTROWS('Paid Contributor Bridge') = 1, IF(COUNT('Paid Contributor Bridge'[Residual Nanoaud]) = COUNTROWS('Paid Contributor Bridge'), DIVIDE(SUM('Paid Contributor Bridge'[Residual Nanoaud]), 1000000000)))
		formatString: #,##0.00

	column 'Charged Area'
		dataType: string
		summarizeBy: none
		sourceColumn: Charged Area

	column 'Financial Unit'
		dataType: string
		summarizeBy: none
		sourceColumn: Financial Unit

	column Grade
		dataType: string
		summarizeBy: none
		sourceColumn: Grade

	column 'Overtime Kind'
		dataType: string
		summarizeBy: none
		sourceColumn: Overtime Kind

	column 'Prior Payend'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Prior Payend

	column Payend
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Payend

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status

	column 'Cost Change Nanoaud'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Cost Change Nanoaud

	column 'Volume Nanoaud'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Volume Nanoaud

	column 'Rate Mix Nanoaud'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Rate Mix Nanoaud

	column 'Residual Nanoaud'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Residual Nanoaud

	column 'Payrun End'
		dataType: string
		summarizeBy: none
		sourceColumn: Payrun End

	column 'Prior Payrun End'
		dataType: string
		summarizeBy: none
		sourceColumn: Prior Payrun End

	partition 'Paid Contributor Bridge' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Charged Area,Financial Unit,Grade,Overtime Kind,Prior Payend,Payend,Status,Cost Change Nanoaud,Volume Nanoaud,Rate Mix Nanoaud,Residual Nanoaud,Payrun End,Prior Payrun End#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="roster--Paid Contributor Bridge.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"Charged Area", type text}, {"Financial Unit", type text}, {"Grade", type text}, {"Overtime Kind", type text}, {"Prior Payend", type text}, {"Payend", type text}, {"Status", type text}, {"Cost Change Nanoaud", Int64.Type}, {"Volume Nanoaud", Int64.Type}, {"Rate Mix Nanoaud", Int64.Type}, {"Residual Nanoaud", Int64.Type}, {"Payrun End", type text}, {"Prior Payrun End", type text}}, "en-AU")
				in
					Typed
