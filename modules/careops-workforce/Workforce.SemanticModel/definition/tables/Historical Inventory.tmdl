/// Aggregate source-evidence observations; separate scope, not current staffing or approved events.
table 'Historical Inventory'

	measure 'Retained Inventory Count' = IF(HASONEVALUE('Historical Inventory'[Inventory]),MAX('Historical Inventory'[Count]),BLANK())
		formatString: #,##0.00

	column Inventory
		dataType: string
		summarizeBy: none
		sourceColumn: Inventory

	column Count
		dataType: int64
		summarizeBy: none
		sourceColumn: Count

	column Meaning
		dataType: string
		summarizeBy: none
		sourceColumn: Meaning

	partition 'Historical Inventory' = m
		mode: import
		source =
				let
				Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Inventory,Count,Meaning#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="embedded--Historical Inventory.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"Inventory", type text},{"Count", Int64.Type},{"Meaning", type text}})
				in Typed
