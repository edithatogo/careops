/// All known charged areas; department is a source reporting label, not a physical roster location.
table Area

	/// Hidden technical key, audit value or explicit-measure input.
	column 'Area Key'
		dataType: int64
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: Area Key

	/// All known charged areas; department is a source reporting label, not a physical roster location. Field: Cost Centre
	column 'Cost Centre'
		dataType: string
		summarizeBy: none
		sourceColumn: Cost Centre

	/// All known charged areas; department is a source reporting label, not a physical roster location. Field: Area
	column Area
		dataType: string
		summarizeBy: none
		sourceColumn: Area

	/// All known charged areas; department is a source reporting label, not a physical roster location. Field: Department
	column Department
		dataType: string
		summarizeBy: none
		sourceColumn: Department

	partition Area = m
		mode: import
		source =
				let
					#"Loaded CSV" = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Area Key,Cost Centre,Area,Department#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="base--Area.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(#"Loaded CSV", [PromoteAllScalars=true]),
					#"Preserved Nulls" = Table.ReplaceValue(#"Promoted Headers", "", null, Replacer.ReplaceValue, Table.ColumnNames(#"Promoted Headers")),
					#"Applied Types" = Table.TransformColumnTypes(#"Preserved Nulls", {{"Area Key", Int64.Type}, {"Cost Centre", type text}, {"Area", type text}, {"Department", type text}}, "en-AU")
				in
					#"Applied Types"
