table 'Planning__Forecast Accuracy'

	column Service
		dataType: string
		summarizeBy: none
		sourceColumn: Service

	column Grade
		dataType: string
		summarizeBy: none
		sourceColumn: Grade

	column Metric
		dataType: string
		summarizeBy: none
		sourceColumn: Metric

	column Model
		dataType: string
		summarizeBy: none
		sourceColumn: Model

	column MAE
		dataType: double
		summarizeBy: none
		sourceColumn: MAE

	column Bias
		dataType: double
		summarizeBy: none
		sourceColumn: Bias

	column Origins
		dataType: double
		summarizeBy: none
		sourceColumn: Origins

	column Evaluation
		dataType: string
		summarizeBy: none
		sourceColumn: Evaluation

	column SourceRevision
		dataType: string
		summarizeBy: none
		sourceColumn: SourceRevision

	partition 'Planning__Forecast Accuracy' = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("Service,Grade,Metric,Model,MAE,Bias,Origins,Evaluation,SourceRevision#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="planning--Forecast Accuracy.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"Service", type text}, {"Grade", type text}, {"Metric", type text}, {"Model", type text}, {"MAE", type number}, {"Bias", type number}, {"Origins", type number}, {"Evaluation", type text}, {"SourceRevision", type text}}, "en-AU")
				in
					Typed
