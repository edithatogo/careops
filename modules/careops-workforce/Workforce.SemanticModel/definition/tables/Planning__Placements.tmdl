table Planning__Placements

	column person
		dataType: string
		summarizeBy: none
		sourceColumn: person

	column version
		dataType: string
		summarizeBy: none
		sourceColumn: version

	column grain
		dataType: string
		summarizeBy: none
		sourceColumn: grain

	column start
		dataType: double
		summarizeBy: none
		sourceColumn: start

	column end
		dataType: double
		summarizeBy: none
		sourceColumn: end

	column labels
		dataType: string
		summarizeBy: none
		sourceColumn: labels

	column state
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column source_revision
		dataType: string
		summarizeBy: none
		sourceColumn: source_revision

	column source_as_of
		dataType: string
		summarizeBy: none
		sourceColumn: source_as_of

	column uncertainty
		dataType: string
		summarizeBy: none
		sourceColumn: uncertainty

	partition Planning__Placements = m
		mode: import
		source =
				let
					Raw = Csv.Document((if #"Source Site" = "" and #"Source Folder" = "" then Text.ToBinary("person,version,grain,start,end,labels,state,source_revision,source_as_of,uncertainty#(lf)") else Binary.Decompress(SharePoint.Contents(#"Source Site", [ApiVersion=15]){[Name="Documents"]}[Content]{[Name=#"Source Folder"]}[Content]{[Name="planning--Placements.csv.gz"]}[Content], Compression.GZip)), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"person", type text}, {"version", type text}, {"grain", type text}, {"start", type number}, {"end", type number}, {"labels", type text}, {"state", type text}, {"source_revision", type text}, {"source_as_of", type text}, {"uncertainty", type text}}, "en-AU")
				in
					Typed
