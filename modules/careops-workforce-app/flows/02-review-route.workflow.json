{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "0.1.0.0",
  "parameters": {},
  "triggers": {
    "PowerAppsV2": {
      "type": "Request",
      "kind": "PowerAppV2",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "operationKey": {
              "type": "string"
            },
            "planKey": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "actions": {
    "Step_01": {
      "type": "Compose",
      "inputs": {
        "design_step": "Read case and version hash",
        "must_bind_before_enable": true
      },
      "runAfter": {}
    },
    "Step_02": {
      "type": "Compose",
      "inputs": {
        "design_step": "Resolve clinical director, HR/IR and delegate with effective-dated role grants",
        "must_bind_before_enable": true
      },
      "runAfter": {
        "Step_01": [
          "Succeeded"
        ]
      }
    },
    "Step_03": {
      "type": "Compose",
      "inputs": {
        "design_step": "Enforce segregation of duties and service boundaries",
        "must_bind_before_enable": true
      },
      "runAfter": {
        "Step_02": [
          "Succeeded"
        ]
      }
    },
    "Step_04": {
      "type": "Compose",
      "inputs": {
        "design_step": "CAS case transition, append immutable decision event",
        "must_bind_before_enable": true
      },
      "runAfter": {
        "Step_03": [
          "Succeeded"
        ]
      }
    },
    "Step_05": {
      "type": "Compose",
      "inputs": {
        "design_step": "Queue next stage or terminal outcome",
        "must_bind_before_enable": true
      },
      "runAfter": {
        "Step_04": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {},
  "_implementationStatus": "binding-required/disabled; placeholder compose actions are NOT operational"
}
