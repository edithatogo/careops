{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "0.2.0.0",
  "parameters": {
    "SharePointSiteUrl": {
      "type": "String",
      "defaultValue": "__BIND_SITE_URL_IN_DEV__",
      "metadata": {
        "description": "Bind only to restricted nonproduction SharePoint site"
      }
    }
  },
  "triggers": {
    "Schedule": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Hour",
        "interval": 1,
        "timeZone": "E. Australia Standard Time"
      }
    }
  },
  "actions": {
    "Read_Scheduled_Plans": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "@parameters('SharePointSiteUrl')",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('JP_PlanHeads')/items?$select=Id,Key,ActiveVersionKey,Payload&$top=100",
          "parameters/headers": {
            "Accept": "application/json;odata=nometadata"
          }
        }
      },
      "runAfter": {}
    },
    "Count_Scheduled": {
      "type": "Compose",
      "inputs": "@length(coalesce(body('Read_Scheduled_Plans')?['value'], createArray()))",
      "runAfter": {
        "Read_Scheduled_Plans": [
          "Succeeded"
        ]
      }
    },
    "Gate": {
      "type": "Compose",
      "inputs": {
        "warning": "Candidate list head count only; do not activate without effective-date and delegated checks",
        "state": "read-only"
      },
      "runAfter": {
        "Count_Scheduled": [
          "Succeeded"
        ]
      }
    },
    "Failure_Receipt": {
      "type": "Compose",
      "inputs": {
        "monitor": "activation",
        "error": "Read failed; no activation performed"
      },
      "runAfter": {
        "Read_Scheduled_Plans": [
          "Failed",
          "TimedOut"
        ]
      }
    }
  },
  "outputs": {},
  "_candidateStatus": "READ_ONLY_UNBOUND_REQUIRES_TENANT_IMPORT_AND_ACL_QUALIFICATION",
  "_notes": {
    "source": "SharePoint Standard HttpRequest only; service-account connection must be least privilege",
    "do_not_enable_before": "restricted site, approved DLP, list ACLs, connection ownership, source readback; monitoring only",
    "credentials": "never stored in source or triggers",
    "limit": "first page only; ensure pagination and list threshold qualification"
  }
}
