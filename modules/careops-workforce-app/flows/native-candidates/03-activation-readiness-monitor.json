{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "0.2.0.0",
  "parameters": {
    "SharePointSiteUrl": {
      "type": "string",
      "defaultValue": "__BIND_SITE_URL_IN_DEV__",
      "metadata": {
        "description": "Bind only to restricted nonproduction SharePoint site"
      }
    }
  },
  "triggers": {
    "Schedule": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Hour",
        "interval": 1,
        "timeZone": "E. Australia Standard Time"
      }
    }
  },
  "actions": {
    "Read_Scheduled_Plans": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "@parameters('SharePointSiteUrl')",
          "parameters/method": "GET",
          "parameters/uri": "_api/web/lists/getbytitle('JP_PlanHeads')/items?$select=Id,Key,ActiveVersionKey&$top=100",
          "parameters/headers": {
            "Accept": "application/json;odata=nometadata"
          }
        }
      },
      "runAfter": {}
    },
    "Gate": {
      "type": "Compose",
      "inputs": {
        "warning": "Plan-head connectivity only: no scheduled candidate or due activation determined; never activate from this flow",
        "state": "read-only"
      },
      "runAfter": {
        "Count_Heads": [
          "Succeeded"
        ]
      }
    },
    "Failure_Receipt": {
      "type": "Terminate",
      "inputs": {
        "runStatus": "Failed",
        "runError": {
          "code": "SharePointReadFailed",
          "message": "Read failed; no activation performed"
        }
      },
      "runAfter": {
        "Read_Scheduled_Plans": [
          "Failed",
          "TimedOut"
        ]
      }
    },
    "Count_Heads": {
      "type": "Compose",
      "inputs": "@length(coalesce(body('Read_Scheduled_Plans')?['value'], json('[]')))",
      "runAfter": {
        "Read_Scheduled_Plans": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
