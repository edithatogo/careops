table 'VMO GL Bridge'

	measure 'Total VMO GL Bridge Amount' = SUM('VMO GL Bridge'[TRN_AMOUNT_1])
		dataType: double
		formatString: $#,##0.00

	column FIN_YEAR
		dataType: string
		sourceColumn: FIN_YEAR

	column FIN_MONTH
		dataType: string
		sourceColumn: FIN_MONTH

	column COST_CENTRE
		dataType: string
		sourceColumn: COST_CENTRE

	column ACCOUNT
		dataType: string
		sourceColumn: ACCOUNT

	column TRN_AMOUNT_1
		dataType: double
		formatString: $#,##0.00
		sourceColumn: TRN_AMOUNT_1

	partition 'VMO GL Bridge' = m
		mode: import
		source = let Source = Table.FromRecords({[FIN_YEAR="2025-26", FIN_MONTH="Jul", COST_CENTRE="CC100", ACCOUNT="6001", TRN_AMOUNT_1=41000.00], [FIN_YEAR="2025-26", FIN_MONTH="Aug", COST_CENTRE="CC200", ACCOUNT="6002", TRN_AMOUNT_1=37000.00], [FIN_YEAR="2025-26", FIN_MONTH="Sep", COST_CENTRE="CC300", ACCOUNT="6003", TRN_AMOUNT_1=29000.00]}), Typed = Table.TransformColumnTypes(Source, {{"FIN_YEAR", type text}, {"FIN_MONTH", type text}, {"COST_CENTRE", type text}, {"ACCOUNT", type text}, {"TRN_AMOUNT_1", type number}}) in Typed
