      "runAfter": {
        "Case_etag": [
          "Succeeded"
        ]
      }
    },
    "Require_pins": {
      "type": "If",
      "expression": "@and(not(empty(outputs('Case_etag'))),not(empty(outputs('File_etag'))),not(equals(outputs('Case_etag'),'*')),not(equals(outputs('File_etag'),'*')))",
      "actions": {},
      "else": {
        "actions": {
          "Hold_pins": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "SubmissionHeld",
                "message": "Fresh native case and document concurrency tokens are required."
              }
            }
          }
        }
      },
      "runAfter": {
        "File_etag": [
          "Succeeded"
        ]
      }
    },
    "Case_metadata": {
      "type": "Compose",
      "inputs": {
        "evidenceDraftLink": "@outputs('Working_URL')"
      },
      "runAfter": {
        "Require_pins": [
          "Succeeded"
        ]
      }
    },
    "Link_case": {
      "type": "If",
      "expression": "@empty(body('Case_item')?['evidenceDraftLink'])",
      "actions": {
        "Set_draft_link": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "{{SITE}}",
              "parameters/method": "POST",
              "parameters/uri": "@concat('_api/web/lists(guid''{{QUEUE_ID}}'')/items(',string(outputs('Case_id')),')')",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json;odata=nometadata",
                "IF-MATCH": "@outputs('Case_etag')",
                "X-HTTP-Method": "MERGE"
              },
              "parameters/body": "@string(outputs('Case_metadata'))"
            },
            "retryPolicy": {
              "type": "none"
            }
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "Case_metadata": [
          "Succeeded"
        ]
      }
    },
    "File_metadata": {
      "type": "Compose",
      "inputs": {
        "PPGDocumentUID": "@outputs('UID')",
        "PPGOriginalFilename": "@outputs('Filename')",
        "PPGPolicyEdition": "@outputs('Revision')",
        "PPGCurrency": "Unconfirmed",
        "PPGCaptureKind": "Review submission",
        "PPGCaptureEditionEvidence": "@string(outputs('Evidence'))"
      },
      "runAfter": {
        "Link_case": [
          "Succeeded"
        ]
      }
    },
    "Classify": {
      "type": "If",
      "expression": "@empty(body('File_item')?['PPGDocumentUID'])",
      "actions": {
        "Link_draft_file": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "{{SITE}}",
              "parameters/method": "POST",
              "parameters/uri": "@concat('_api/web/GetFileByServerRelativePath(decodedurl=''',uriComponent(outputs('Working_path')),''')/ListItemAllFields')",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json;odata=nometadata",
                "IF-MATCH": "@outputs('File_etag')",
                "X-HTTP-Method": "MERGE"
              },
              "parameters/body": "@string(outputs('File_metadata'))"
            },
            "retryPolicy": {
              "type": "none"
            }
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "File_metadata": [
          "Succeeded"
        ]
      }
    },
    "Verify_file": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "{{SITE}}",
          "parameters/method": "GET",
          "parameters/uri": "@concat('_api/web/GetFileByServerRelativePath(decodedurl=''',uriComponent(outputs('Working_path')),''')/ListItemAllFields')",
          "parameters/headers": {
            "Accept": "application/json;odata=nometadata",
            "Content-Type": "application/json;odata=nometadata"
          }
        },
        "retryPolicy": {
          "type": "none"
        }
      },
      "runAfter": {
        "Classify": [
          "Succeeded"
        ]
      }
    },
    "Verify_case": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "{{SITE}}",
          "parameters/method": "GET",
          "parameters/uri": "@concat('_api/web/lists(guid''{{QUEUE_ID}}'')/items(',string(outputs('Case_id')),')')",
          "parameters/headers": {
            "Accept": "application/json;odata=nometadata",
            "Content-Type": "application/json;odata=nometadata"
          }
        },
        "retryPolicy": {
          "type": "none"
        }
      },
      "runAfter": {
        "Verify_file": [
          "Succeeded"
        ]
      }
    },
    "Readback": {
      "type": "If",
      "expression": "@and(equals(body('Verify_case')?['evidenceDraftLink'],outputs('Working_URL')),equals(body('Verify_file')?['PPGDocumentUID'],outputs('UID')),equals(body('Verify_file')?['PPGCaptureEditionEvidence'],string(outputs('Evidence'))),equals(body('Verify_file')?['PPGCaptureKind'],'Review submission'))",
      "actions": {},
      "else": {
        "actions": {
          "Hold_readback": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "SubmissionHeld",
                "message": "A native readback does not match this revision. Inspect the case before resubmitting."
              }
            }
          }
        }
      },
      "runAfter": {
        "Verify_case": [
          "Succeeded"
        ]
      }
    },
    "Preservation_name": {
      "type": "Compose",
      "inputs": "@concat(outputs('Filename'),'.original')",
      "runAfter": {
        "Filename": [
          "Succeeded"
        ]
      }
    },
    "Copy_parameters": {
      "type": "Compose",
      "inputs": {
        "srcPath": {
          "DecodedUrl": "@concat('{{ORIGIN}}',outputs('Original_path'))"
        },
        "destPath": {
          "DecodedUrl": "@outputs('Working_URL')"
        },
        "overwrite": false,
        "options": {
          "ShouldBypassSharedLocks": false,
          "KeepBoth": false
        }
      },
      "runAfter": {
        "Existing_file": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
