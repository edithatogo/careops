{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/careops/blob/main/conductor/tracks/registration_assurance_20261113/registration-observation.schema.json",
  "title": "CareOps RegistrationObservation 1.0/1.1 design envelope",
  "description": "1.0 compatibility plus 1.1 lossless regulatory detail. Source-only; business invariants must also be enforced by consumers. Date-time fields must match an explicit offset-aware lexical pattern as well as RFC3339/date format and strict semantic parsing; do not assume optional JSON Schema format checkers are installed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observationId",
    "watchRef",
    "practitioner",
    "provider",
    "sourceHealth",
    "observedAtUtc",
    "evidence",
    "signal",
    "assessment",
    "correlationId",
    "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "observationId": {
      "type": "string",
      "minLength": 1
    },
    "watchRef": {
      "type": "string",
      "minLength": 1
    },
    "practitioner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regulator",
        "registrationNumber"
      ],
      "properties": {
        "regulator": {
          "const": "AHPRA"
        },
        "registrationNumber": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "qualificationRef",
        "evidenceCeiling",
        "mappingVersion"
      ],
      "properties": {
        "kind": {
          "enum": [
            "MOCK",
            "AHPRA_PUBLIC_AUTOCOMPLETE",
            "AHPRA_PUBLIC_REGISTER_HUMAN",
            "AHPRA_PIE_FIND",
            "AHPRA_PIE_IDENTITY"
          ]
        },
        "qualificationRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidenceCeiling": {
          "enum": [
            "test_only",
            "discovery_only",
            "qualified_identity_only",
            "qualified_regulatory",
            "human_verified"
          ]
        },
        "mappingVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceHealth": {
      "enum": [
        "healthy",
        "blocked",
        "rate_limited",
        "transport_error",
        "schema_drift",
        "stale",
        "unknown"
      ]
    },
    "observedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRef",
        "asOfUtc",
        "payloadSha256",
        "sourceRevision",
        "classification"
      ],
      "properties": {
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "asOfUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "payloadSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "classification": {
          "enum": [
            "synthetic",
            "restricted_staff",
            "restricted_regulatory"
          ]
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityState",
        "registrationStatus",
        "expiryDate",
        "conditionsIndicator"
      ],
      "properties": {
        "identityState": {
          "enum": [
            "matched",
            "candidate",
            "ambiguous",
            "unresolved"
          ]
        },
        "registrationStatus": {
          "enum": [
            "registered",
            "not_registered",
            "suspended",
            "cancelled",
            "unknown"
          ]
        },
        "expiryDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "conditionsIndicator": {
          "enum": [
            "present",
            "absent",
            "unknown"
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reviewState",
        "ruleVersion",
        "reasonCodes"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "discovery_only",
            "no_material_change",
            "potential_change",
            "verification_required",
            "source_unavailable"
          ]
        },
        "reviewState": {
          "enum": [
            "not_applicable",
            "pending",
            "reviewed",
            "superseded"
          ]
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "registrationDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeStatusCode",
        "sourceVocabularyVersion",
        "categories",
        "specialties",
        "endorsements",
        "restrictions"
      ],
      "properties": {
        "nativeStatusCode": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sourceVocabularyVersion": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "general",
              "specialist",
              "provisional",
              "limited",
              "non_practising",
              "other",
              "unknown"
            ]
          }
        },
        "specialties": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "endorsements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "evidenceRef",
              "nativeCode"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "condition",
                  "undertaking",
                  "supervision",
                  "reprimand",
                  "other",
                  "unknown"
                ]
              },
              "evidenceRef": {
                "type": "string",
                "minLength": 1
              },
              "nativeCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effectiveDate": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "scopeRef": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "kind": {
                "const": "AHPRA_PUBLIC_AUTOCOMPLETE"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "evidenceCeiling": {
                "const": "discovery_only"
              }
            }
          },
          "signal": {
            "properties": {
              "identityState": {
                "enum": [
                  "candidate",
                  "ambiguous",
                  "unresolved"
                ]
              },
              "registrationStatus": {
                "const": "unknown"
              },
              "expiryDate": {
                "type": "null"
              },
              "conditionsIndicator": {
                "const": "unknown"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "const": "discovery_only"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "kind": {
                "const": "MOCK"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "evidenceCeiling": {
                "const": "test_only"
              }
            }
          },
          "evidence": {
            "properties": {
              "classification": {
                "const": "synthetic"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "kind": {
                "enum": [
                  "AHPRA_PIE_FIND",
                  "AHPRA_PIE_IDENTITY"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "practitioner": {
            "properties": {
              "registrationNumber": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceHealth": {
            "enum": [
              "blocked",
              "rate_limited",
              "transport_error",
              "schema_drift",
              "stale",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "signal": {
            "properties": {
              "registrationStatus": {
                "const": "unknown"
              },
              "conditionsIndicator": {
                "const": "unknown"
              },
              "expiryDate": {
                "type": "null"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "enum": [
                  "source_unavailable",
                  "verification_required"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "kind": {
                "enum": [
                  "AHPRA_PIE_FIND",
                  "AHPRA_PIE_IDENTITY",
                  "AHPRA_PUBLIC_REGISTER_HUMAN"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "signal": {
            "properties": {
              "registrationStatus": {
                "enum": [
                  "registered",
                  "not_registered",
                  "suspended",
                  "cancelled"
                ]
              }
            },
            "required": [
              "registrationStatus"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "kind": {
                "enum": [
                  "AHPRA_PIE_FIND",
                  "AHPRA_PUBLIC_REGISTER_HUMAN"
                ]
              },
              "qualificationRef": {
                "type": "string",
                "minLength": 1
              },
              "evidenceCeiling": {
                "enum": [
                  "qualified_regulatory",
                  "human_verified"
                ]
              }
            }
          },
          "sourceHealth": {
            "const": "healthy"
          },
          "practitioner": {
            "properties": {
              "registrationNumber": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "signal": {
            "properties": {
              "identityState": {
                "const": "matched"
              }
            }
          },
          "evidence": {
            "properties": {
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "asOfUtc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.1.0"
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "registrationDetail"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "kind": {
                "const": "AHPRA_PIE_FIND"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "evidenceCeiling": {
                "const": "qualified_regulatory"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "kind": {
                "const": "AHPRA_PUBLIC_REGISTER_HUMAN"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "evidenceCeiling": {
                "const": "human_verified"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "kind": {
                "const": "AHPRA_PIE_IDENTITY"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "evidenceCeiling": {
                "const": "qualified_identity_only"
              }
            }
          },
          "signal": {
            "properties": {
              "registrationStatus": {
                "const": "unknown"
              },
              "conditionsIndicator": {
                "const": "unknown"
              },
              "expiryDate": {
                "type": "null"
              }
            }
          },
          "assessment": {
            "properties": {
              "outcome": {
                "enum": [
                  "verification_required",
                  "source_unavailable"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "kind": {
                "const": "MOCK"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "reviewState": {
                "enum": [
                  "not_applicable",
                  "pending"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.1.0"
          },
          "signal": {
            "properties": {
              "registrationStatus": {
                "enum": [
                  "registered",
                  "not_registered",
                  "suspended",
                  "cancelled"
                ]
              }
            },
            "required": [
              "registrationStatus"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "signal"
        ]
      },
      "then": {
        "properties": {
          "registrationDetail": {
            "properties": {
              "nativeStatusCode": {
                "type": "string",
                "minLength": 1
              },
              "categories": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
