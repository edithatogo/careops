{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.6.0/schema.json",
  "name": "InfluencerFacilityChart",
  "position": {
    "x": 20,
    "y": 20,
    "z": 1,
    "height": 160,
    "width": 380,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimOrganisation"
                    }
                  },
                  "Property": "facility"
                }
              },
              "queryRef": "DimOrganisation.facility",
              "nativeQueryRef": "facility",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "MeasureTable"
                    }
                  },
                  "Property": "High Harm %"
                }
              },
              "queryRef": "MeasureTable.High Harm %",
              "nativeQueryRef": "High Harm %"
            }
          ]
        }
      }
    }
  }
}
