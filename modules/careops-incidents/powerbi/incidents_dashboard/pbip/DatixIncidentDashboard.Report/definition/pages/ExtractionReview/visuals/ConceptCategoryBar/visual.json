{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.6.0/schema.json",
  "name": "ConceptCategoryBar",
  "position": {
    "x": 20,
    "y": 130,
    "z": 2,
    "height": 250,
    "width": 560,
    "tabOrder": 2
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "HealthConceptMonthly"
                    }
                  },
                  "Property": "concept_label"
                }
              },
              "queryRef": "HealthConceptMonthly.concept_label",
              "nativeQueryRef": "concept_label",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "MeasureTable"
                    }
                  },
                  "Property": "Extracted Concept Matches"
                }
              },
              "queryRef": "MeasureTable.Extracted Concept Matches",
              "nativeQueryRef": "Extracted Concept Matches"
            }
          ]
        }
      }
    }
  }
}
