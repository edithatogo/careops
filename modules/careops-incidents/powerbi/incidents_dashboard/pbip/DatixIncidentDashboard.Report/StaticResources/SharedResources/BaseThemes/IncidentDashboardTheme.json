{
  "name": "CareOps Incident Dashboard",
  "dataColors": [
    "#1F77B4",
    "#2CA02C",
    "#FF7F0E",
    "#D62728",
    "#9467BD",
    "#17BECF",
    "#7F7F7F",
    "#8C564B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F77B4",
  "good": "#2E7D32",
  "neutral": "#6B7280",
  "bad": "#B91C1C",
  "maximum": "#B91C1C",
  "center": "#F59E0B",
  "minimum": "#2E7D32",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ],
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 22,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#111827"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "color": {
              "solid": {
                "color": "#4B5563"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            }
          }
        ],
        "items": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#374151"
              }
            }
          }
        ]
      }
    }
  }
}
