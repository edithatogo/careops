/// Aggregate QA metrics for health-concept extraction.
table HealthConceptQA
	lineageTag: a731ba16-d590-4072-959a-7aa47353cbb9

	column metric_key
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: metric_key

	column metric_label
		dataType: string
		summarizeBy: none
		sourceColumn: metric_label

	column metric_value
		dataType: int64
		summarizeBy: none
		sourceColumn: metric_value

	column metric_note
		dataType: string
		summarizeBy: none
		sourceColumn: metric_note

	partition HealthConceptQA = m
		mode: import
		source =
				let
					Root = RootDataPath & "\powerbi\incidents_dashboard\data\health_concept_qa_v1_20260429.csv",
					Source = Csv.Document(
						File.Contents(Root),
						[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
					),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Types = Table.TransformColumnTypes(
						Headers,
						{
							{"metric_key", type text},
							{"metric_label", type text},
							{"metric_value", Int64.Type},
							{"metric_note", type text}
						},
						"en-AU"
					)
				in
					Types
