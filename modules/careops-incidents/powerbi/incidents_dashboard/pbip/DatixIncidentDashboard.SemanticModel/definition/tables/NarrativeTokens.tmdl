/// Hidden schema placeholder for future word-cloud and narrative analysis. Disabled by default for fast Desktop refresh.
table NarrativeTokens
	lineageTag: 8e9b6d40-c8da-4d6e-9ce5-8a6b7de2a061
	isHidden

	column token
		dataType: string
		summarizeBy: none
		sourceColumn: token

	column token_count
		dataType: int64
		summarizeBy: none
		sourceColumn: token_count

	partition NarrativeTokens = m
		mode: import
		source =
				#table(
					type table [token = text, token_count = Int64.Type],
					{}
				)
