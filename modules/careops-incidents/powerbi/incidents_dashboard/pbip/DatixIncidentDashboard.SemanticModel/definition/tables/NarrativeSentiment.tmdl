/// Hidden schema placeholder for simple native sentiment scoring. Disabled by default for fast Desktop refresh.
table NarrativeSentiment
	lineageTag: 8e9b6d40-c8da-4d6e-9ce5-8a6b7de2a062
	isHidden

	column encrypted_reference_id
		dataType: string
		summarizeBy: none
		sourceColumn: encrypted_reference_id

	column positive_count
		dataType: int64
		summarizeBy: none
		sourceColumn: positive_count

	column negative_count
		dataType: int64
		summarizeBy: none
		sourceColumn: negative_count

	column sentiment_score
		dataType: int64
		summarizeBy: none
		sourceColumn: sentiment_score

	column sentiment_label
		dataType: string
		summarizeBy: none
		sourceColumn: sentiment_label

	partition NarrativeSentiment = m
		mode: import
		source =
				#table(
					type table [
						encrypted_reference_id = text,
						positive_count = Int64.Type,
						negative_count = Int64.Type,
						sentiment_score = Int64.Type,
						sentiment_label = text
					],
					{}
				)
