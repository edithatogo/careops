/// Precomputed rare-event surveillance outputs for low-frequency and overdispersed incident counts.
table SurveillanceMonthly
	lineageTag: b279ba17-3757-4384-9d2c-a4f71105037f

	column month_start
		dataType: dateTime
		summarizeBy: none
		sourceColumn: month_start

	column cohort_key
		dataType: string
		summarizeBy: none
		sourceColumn: cohort_key

	column cohort_label
		dataType: string
		summarizeBy: none
		sourceColumn: cohort_label

	column incident_count
		dataType: int64
		summarizeBy: sum
		sourceColumn: incident_count

	column expected_count
		dataType: double
		summarizeBy: none
		sourceColumn: expected_count

	column variance_count
		dataType: double
		summarizeBy: none
		sourceColumn: variance_count

	column dispersion_index
		dataType: double
		summarizeBy: none
		sourceColumn: dispersion_index

	column empirical_p95_limit
		dataType: double
		summarizeBy: none
		sourceColumn: empirical_p95_limit

	column empirical_p99_limit
		dataType: double
		summarizeBy: none
		sourceColumn: empirical_p99_limit

	column overdispersion_ucl_95
		dataType: double
		summarizeBy: none
		sourceColumn: overdispersion_ucl_95

	column overdispersion_ucl_99
		dataType: double
		summarizeBy: none
		sourceColumn: overdispersion_ucl_99

	column ewma_value
		dataType: double
		summarizeBy: none
		sourceColumn: ewma_value

	column ewma_ucl
		dataType: double
		summarizeBy: none
		sourceColumn: ewma_ucl

	column cusum_value
		dataType: double
		summarizeBy: none
		sourceColumn: cusum_value

	column cusum_signal
		dataType: boolean
		summarizeBy: none
		sourceColumn: cusum_signal

	column ewma_signal
		dataType: boolean
		summarizeBy: none
		sourceColumn: ewma_signal

	column above_empirical_p95
		dataType: boolean
		summarizeBy: none
		sourceColumn: above_empirical_p95

	column above_empirical_p99
		dataType: boolean
		summarizeBy: none
		sourceColumn: above_empirical_p99

	column above_overdispersion_ucl_95
		dataType: boolean
		summarizeBy: none
		sourceColumn: above_overdispersion_ucl_95

	column above_overdispersion_ucl_99
		dataType: boolean
		summarizeBy: none
		sourceColumn: above_overdispersion_ucl_99

	column run_above_median_length
		dataType: int64
		summarizeBy: none
		sourceColumn: run_above_median_length

	column run_signal
		dataType: boolean
		summarizeBy: none
		sourceColumn: run_signal

	column is_partial_month
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_partial_month

	column signal_requires_review
		dataType: boolean
		summarizeBy: none
		sourceColumn: signal_requires_review

	column heparin_min_days_since_prior
		dataType: int64
		summarizeBy: min
		sourceColumn: heparin_min_days_since_prior

	column heparin_median_days_since_prior
		dataType: double
		summarizeBy: average
		sourceColumn: heparin_median_days_since_prior

	column method_note
		dataType: string
		summarizeBy: none
		sourceColumn: method_note

	partition SurveillanceMonthly = m
		mode: import
		source =
				let
					Root = RootDataPath & "\powerbi\incidents_dashboard\data\surveillance_monthly_v1_20260429.csv",
					Source = Csv.Document(
						File.Contents(Root),
						[Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
					),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Types = Table.TransformColumnTypes(
						Headers,
						{
							{"month_start", type date},
							{"cohort_key", type text},
							{"cohort_label", type text},
							{"incident_count", Int64.Type},
							{"expected_count", type number},
							{"variance_count", type number},
							{"dispersion_index", type number},
							{"empirical_p95_limit", type number},
							{"empirical_p99_limit", type number},
							{"overdispersion_ucl_95", type number},
							{"overdispersion_ucl_99", type number},
							{"ewma_value", type number},
							{"ewma_ucl", type number},
							{"cusum_value", type number},
							{"cusum_signal", type logical},
							{"ewma_signal", type logical},
							{"above_empirical_p95", type logical},
							{"above_empirical_p99", type logical},
							{"above_overdispersion_ucl_95", type logical},
							{"above_overdispersion_ucl_99", type logical},
							{"run_above_median_length", Int64.Type},
							{"run_signal", type logical},
							{"is_partial_month", type logical},
							{"signal_requires_review", type logical},
							{"heparin_min_days_since_prior", Int64.Type},
							{"heparin_median_days_since_prior", type number},
							{"method_note", type text}
						},
						"en-AU"
					)
				in
					Types
