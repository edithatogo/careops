{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>edithatogo/renovate-config:careops-dev#c11fa28421687fbdaccb92ae0f5006c484fc1ed2"
  ],
  "automerge": false,
  "pip-compile": {
    "managerFilePatterns": ["/^requirements-dev\\.lock$/"]
  },
  "pip_requirements": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/(?:development-canary|dependency-candidate)\\.yml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]+UV_VERSION:[ \\t]*'(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?)'"
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [".python-version"],
      "allowedVersions": "/^3\\.15\\./"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "astral-sh/uv"
      ],
      "ignoreUnstable": false,
      "automerge": false
    }
  ]
}
