{
  "schemaVersion": "1.1.0-proposed",
  "status": "design-not-provisioned",
  "supersedes": "Historical CKAN_ physical-name proposal in this manifest's Git history; no native migration was performed",
  "product": "CareOps Catalogue",
  "approach": "SharePoint native Lists and Libraries core first; configuration before code; no bespoke SPFx or CKAN runtime",
  "canonicalIds": "UUID strings independent of SharePoint IDs, filenames, paths and source module identities",
  "sourceAuthority": {
    "datasets": "Catalogue_Datasets List",
    "resources": "Catalogue_Resources List",
    "files": "Catalogue_Assets Library",
    "approvals": "External CareOps/organisation governing systems; catalogue reference only",
    "security": "Actual SharePoint permissions, not metadata display status",
    "organisations": "Reuse authorised existing organisation taxonomy/list; optional new list after gap analysis"
  },
  "core": {
    "lists": [
      {
        "name": "Catalogue_Datasets",
        "purpose": "dataset/master metadata",
        "idColumn": "DatasetID",
        "indexed": [
          "DatasetID",
          "OwnerRole",
          "LifecycleStatus",
          "AccessClass",
          "ClinicalDomainCode"
        ],
        "columns": [
          {
            "name": "DatasetID",
            "type": "Text",
            "unique": true
          },
          {
            "name": "Title",
            "type": "Text",
            "required": true
          },
          {
            "name": "Description",
            "type": "Note"
          },
          {
            "name": "OwnerRole",
            "type": "Text"
          },
          {
            "name": "SourceQualifiedID",
            "type": "Text"
          },
          {
            "name": "ClinicalDomainCode",
            "type": "Text"
          },
          {
            "name": "LifecycleStatus",
            "type": "Choice",
            "options": [
              "draft",
              "active",
              "under-review",
              "withdrawn",
              "archived"
            ]
          },
          {
            "name": "AccessClass",
            "type": "Choice",
            "options": [
              "not-assessed",
              "internal",
              "restricted",
              "approved-public"
            ]
          },
          {
            "name": "MetadataRevision",
            "type": "Text"
          },
          {
            "name": "LastVerifiedUTC",
            "type": "DateTime"
          }
        ]
      },
      {
        "name": "Catalogue_Resources",
        "purpose": "resource/link metadata, separate from files",
        "idColumn": "ResourceID",
        "indexed": [
          "ResourceID",
          "DatasetID",
          "ResourceType",
          "AccessClass"
        ],
        "columns": [
          {
            "name": "ResourceID",
            "type": "Text",
            "unique": true
          },
          {
            "name": "DatasetID",
            "type": "Text",
            "required": true
          },
          {
            "name": "Title",
            "type": "Text",
            "required": true
          },
          {
            "name": "ResourceType",
            "type": "Choice",
            "options": [
              "file",
              "external-link",
              "report",
              "dictionary",
              "protocol",
              "api-reference"
            ]
          },
          {
            "name": "AssetID",
            "type": "Text"
          },
          {
            "name": "ExternalResourceURI",
            "type": "URL"
          },
          {
            "name": "AccessClass",
            "type": "Choice",
            "options": [
              "not-assessed",
              "internal",
              "restricted",
              "approved-public"
            ]
          },
          {
            "name": "SourceQualifiedID",
            "type": "Text"
          },
          {
            "name": "SourceRevision",
            "type": "Text"
          },
          {
            "name": "ReviewStatus",
            "type": "Choice",
            "options": [
              "unreviewed",
              "verified",
              "needs-review",
              "withdrawn"
            ]
          }
        ]
      }
    ],
    "libraries": [
      {
        "name": "Catalogue_Assets",
        "purpose": "file bytes/versions; metadata projection and publication artefacts",
        "contentTypes": [
          "Catalogue Resource File",
          "Catalogue Data Dictionary",
          "Catalogue Protocol",
          "Catalogue Report",
          "Catalogue Release Receipt"
        ],
        "columns": [
          "CAT_DatasetID",
          "CAT_ResourceID",
          "CAT_AssetID",
          "CAT_ArtifactKind",
          "CAT_SourceQualifiedID",
          "CAT_DataStage",
          "CAT_AccessClass",
          "CAT_ReviewStatus",
          "CAT_ReceivedUTC",
          "CAT_ContentSHA256",
          "CAT_ReleaseReference"
        ],
        "permissions": "provision only in an approved classification/retention boundary; split libraries/sites for different access classes"
      }
    ],
    "sharedSiteColumns": [
      {
        "name": "CAT_DatasetID",
        "type": "Text",
        "indexed": true
      },
      {
        "name": "CAT_ResourceID",
        "type": "Text",
        "indexed": true
      },
      {
        "name": "CAT_AssetID",
        "type": "Text",
        "indexed": true
      },
      {
        "name": "CAT_ArtifactKind",
        "type": "Choice",
        "options": [
          "source",
          "dictionary",
          "protocol",
          "report",
          "aggregate",
          "release-receipt"
        ]
      },
      {
        "name": "CAT_SourceQualifiedID",
        "type": "Text"
      },
      {
        "name": "CAT_DataStage",
        "type": "Choice",
        "options": [
          "bronze",
          "silver",
          "gold",
          "platinum"
        ],
        "note": "logical provenance/curation stage, not security level"
      },
      {
        "name": "CAT_AccessClass",
        "type": "Choice",
        "options": [
          "not-assessed",
          "internal",
          "restricted",
          "approved-public"
        ]
      },
      {
        "name": "CAT_ReviewStatus",
        "type": "Choice",
        "options": [
          "unreviewed",
          "verified",
          "needs-review",
          "withdrawn"
        ]
      },
      {
        "name": "CAT_ReceivedUTC",
        "type": "DateTime"
      },
      {
        "name": "CAT_ContentSHA256",
        "type": "Text",
        "note": "trusted hash captured through approved workflow, not automatically computed by SharePoint"
      },
      {
        "name": "CAT_ReleaseReference",
        "type": "Text"
      }
    ],
    "views": [
      "Datasets - Active",
      "Datasets - By Domain",
      "Datasets - Needs Review",
      "Resources - By Dataset",
      "Resources - By Type",
      "Assets - Published"
    ],
    "sitePage": [
      "Quick Links",
      "List web part",
      "Document Library web part",
      "Highlighted Content (optional)"
    ],
    "forms": [
      "Microsoft Lists dataset registration form",
      "Native resource edit form"
    ],
    "gate": "approved test site, exact readback, index/permission validation, fictional fixture and recoverable deployment"
  },
  "optionalAfterCore": [
    {
      "feature": "OrganisationReference",
      "gate": "no existing authoritative taxonomy",
      "object": "Catalogue_Organizations"
    },
    {
      "feature": "ProvenanceLineage",
      "gate": "multiple datasets require source-target provenance edges",
      "object": "Catalogue_Lineage"
    },
    {
      "feature": "ReleaseLedger",
      "gate": "approved publication requires independent manifest records",
      "object": "Catalogue_Releases"
    },
    {
      "feature": "GovernanceEvidenceProjection",
      "gate": "multiple external approvals need structured many-to-many links",
      "object": "Catalogue_GovernanceLinks"
    },
    {
      "feature": "VocabularyRelationships",
      "gate": "term set/choice insufficient for clinically versioned mappings",
      "object": "Catalogue_Vocabularies"
    },
    {
      "feature": "AdditionalLibraries",
      "gate": "security, retention, restore or lifecycle require physical segmentation",
      "object": [
        "Catalogue_RestrictedAssets",
        "Catalogue_PublishedAssets"
      ]
    },
    {
      "feature": "SearchExtension",
      "gate": "native views fail faceted discovery requirements and approved app catalogue exists",
      "upstream": "microsoft-search/pnp-modern-search",
      "candidateVersion": "4.25.0"
    }
  ],
  "prohibitedAsCoreDependencies": [
    "SPFx bespoke React",
    "CKAN server and extensions",
    "CKAN file-keeper",
    "PostgreSQL",
    "Solr",
    "Redis",
    "Dataverse Premium",
    "Fabric",
    "Copilot",
    "Power Apps Code Apps",
    "AI Builder",
    "Power BI PPU",
    "premium Power Automate connectors",
    "SQLite database in SharePoint"
  ],
  "releaseContract": [
    "dry-run default",
    "idempotent provisioning",
    "no destructive drift repair",
    "source-qualified UUIDs",
    "privacy controls",
    "file denial tests",
    "schema readback",
    "support owner",
    "rollback receipt"
  ],
  "documentation": [
    "docs/clinical-data-catalogue/architecture.md",
    "docs/clinical-data-catalogue/sharepoint-native-build-plan.md",
    "conductor/tracks/ckan_catalogue_20261106/plan.md"
  ]
}
