{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/careops/portfolio/rims/contracts/domains/shared.schema.json",
  "title": "CareOps-RIMS shared vertical",
  "type": "object",
  "description": "Bronze retains maximum permitted original fields and nested structures; Silver maps typed identifiers and provenance; Gold surfaces reconciled review-aware views; Platinum offers evidenced intelligence.",
  "required": [
    "entity_id",
    "source_assertions",
    "lineage",
    "quality",
    "intelligence"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "source_assertions": {
      "type": "object"
    },
    "lineage": {
      "type": "object"
    },
    "quality": {
      "type": "object"
    },
    "intelligence": {
      "type": "object"
    },
    "source_id": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_rights": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "schema_versions": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_health": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "capture_history": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "record_lineage": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "quality_metrics": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "governance_decisions": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "x-medallion-contracts": [
    "bronze",
    "silver",
    "gold",
    "platinum"
  ],
  "x-field-maximisation": "Every source field must be retained when rights/security permit; otherwise record reason for redaction or exclusion; all nested cardinalities and unknown fields accounted for."
}
