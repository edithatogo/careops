{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>edithatogo/renovate-config",
    "github>edithatogo/renovate-config:careops-dev#c11fa28421687fbdaccb92ae0f5006c484fc1ed2"
  ],
  "automerge": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": ">=3.15.0 <3.16.0"
    }
  ],
  "github-actions": {
    "enabled": false
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^modules/clinical-hub-core/requirements-dev\\.lock$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/clinical-hub-candidate\\.yml$/"
      ],
      "matchStrings": [
        "UV_VERSION: '(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)'"
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
