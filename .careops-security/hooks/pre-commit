#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
command -v gitleaks >/dev/null 2>&1 || { echo 'Commit blocked: Gitleaks missing.' >&2; exit 1; }
git diff --cached --check >/dev/null 2>&1 || { echo 'Commit blocked: whitespace gate.' >&2; exit 1; }
gitleaks git . --pre-commit --staged --gitleaks-ignore-path /dev/null --ignore-gitleaks-allow --redact --no-banner >/dev/null 2>&1 || { echo 'Commit blocked: secret gate; diagnostics withheld.' >&2; exit 1; }
repo_python=${REPO_PYTHON:-.venv-careops-privacy/bin/python}
[ -x "$repo_python" ] || { echo 'Commit blocked: privacy runtime missing.' >&2; exit 1; }
"$repo_python" -I .careops-security/check.py >/dev/null 2>&1 || { echo 'Commit blocked: privacy gate; diagnostics withheld.' >&2; exit 1; }
