#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
repo_python=${REPO_PYTHON:-.venv-careops-privacy/bin/python}
if [ -x "$repo_python" ] && CAREOPS_NOTIFICATION_WRAPPED=1 "$repo_python" -I .careops-security/pre_push.py "$@" >/dev/null 2>&1; then
    echo 'CareOps private destination and offline privacy guards passed.'
    exit 0
fi
echo 'CareOps push blocked; diagnostic content withheld.' >&2
if [ -z "${CI:-}" ] && [ "$(uname -s)" = Darwin ]; then
    osascript -e 'display notification "Push blocked. Review the local privacy gate." with title "CareOps privacy"' >/dev/null 2>&1 || true
fi
exit 1
